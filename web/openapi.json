            "type": "string",
            "enum": [
              "offline",
              "api"
            ],
            "title": "Mode",
            "default": "offline"
          },
          "base_url": {
            "type": "string",
            "title": "Base Url",
            "default": "http://127.0.0.1:8080/v1"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "title": "Model"
          },
          "api_key_env": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key Env"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model"
        ],
        "title": "InferenceProfile"
      },
      "RunActivity": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running"
            ],
            "title": "Status"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "task_title": {
            "type": "string",
            "title": "Task Title"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "participant": {
            "type": "string",
            "title": "Participant"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "phase": {
            "type": "string",
            "title": "Phase",
            "default": "queued"
          },
          "turn": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Turn",
            "default": 0
          },
          "max_turns": {
            "type": "integer",
            "title": "Max Turns"
          },
          "wall_seconds": {
            "type": "number",
            "title": "Wall Seconds"
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Elapsed Seconds",
            "default": 0
          },
          "queue_position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Queue Position"
          },
          "last_event_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Event At"
          },
          "last_event_seq": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Last Event Seq",
            "default": 0
          },
          "cancellation_requested": {
            "type": "boolean",
            "title": "Cancellation Requested",
            "default": false
          },
          "last_tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Tool"
          },
          "checks_done": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Checks Done",
            "default": 0
          },
          "checks_total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Checks Total",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "status",
          "task_id",
          "task_title",
          "category",
          "participant",
          "created_at",
          "updated_at",
          "max_turns",
          "wall_seconds"
        ],
        "title": "RunActivity"
      },
      "RunDetail": {
        "properties": {
          "run": {
            "$ref": "#/components/schemas/RunRecord"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactRecord"
            },
            "type": "array",
            "title": "Artifacts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run",
          "artifacts"
        ],
        "title": "RunDetail"
      },
      "RunRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "passed",
              "failed",
              "infrastructure_error",
              "unsupported",
              "cancelled",
              "budget_exhausted",
              "interrupted"
            ],
            "title": "Status"
          },
          "spec": {
            "$ref": "#/components/schemas/RunSpec"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "score": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScoreCard"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "refusal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refusal"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "status",
          "spec",
          "created_at",
          "updated_at"
        ],
        "title": "RunRecord"
      },
      "RunSpec": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "task_id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_-]*\\.[a-z0-9-]+$",
            "title": "Task Id",
            "default": "python.interval-merge"
          },
          "participant": {
            "type": "string",
            "enum": [
              "scripted",
              "openai"
            ],
            "title": "Participant",
            "default": "scripted"
          },
          "scripted_variant": {
            "type": "string",
            "enum": [
              "good",
              "bad",
              "refuse"
            ],
            "title": "Scripted Variant",
            "default": "good"
          },
          "inference": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InferenceProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "generation": {
            "$ref": "#/components/schemas/Generation"
          },
          "budgets": {
            "$ref": "#/components/schemas/Budgets"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RunSpec"
      },
      "ScoreCard": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "grader_version": {
            "type": "string",
            "title": "Grader Version",
            "default": "interval-blackbox/1"
