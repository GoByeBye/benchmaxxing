        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "id": {
            "type": "string",
            "title": "Id",
            "default": "python.interval-merge"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "1.0.0"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": "Repair interval merging"
