          "command_seconds": {
            "type": "number",
            "maximum": 300.0,
            "minimum": 0.1,
            "title": "Command Seconds",
            "default": 10
          },
          "output_bytes": {
            "type": "integer",
            "maximum": 1048576.0,
            "minimum": 1024.0,
            "title": "Output Bytes",
            "default": 65536
          },
          "artifact_bytes": {
            "type": "integer",
            "maximum": 16777216.0,
            "minimum": 1024.0,
            "title": "Artifact Bytes",
            "default": 1048576
          },
          "memory_mb": {
            "type": "integer",
            "maximum": 32768.0,
            "minimum": 64.0,
            "title": "Memory Mb",
            "default": 256
          },
          "cpus": {
            "type": "number",
            "maximum": 32.0,
            "minimum": 0.1,
            "title": "Cpus",
            "default": 1
          },
          "pids": {
            "type": "integer",
            "maximum": 512.0,
            "minimum": 16.0,
            "title": "Pids",
            "default": 64
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Budgets"
      },
      "CheckResult": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "passed"
        ],
        "title": "CheckResult"
      },
      "DoctorReport": {
        "properties": {
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "checks": {
