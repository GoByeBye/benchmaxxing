            "title": "Runs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "server_time",
          "runs"
        ],
        "title": "ActivitySnapshot"
      },
      "ArtifactRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "sha256": {
