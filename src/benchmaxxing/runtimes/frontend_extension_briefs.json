-start;padding:20px}td,th{font-size:13px}.card,form,section{padding:16px}}@media(min-width:640px){.nav-toggle{display:none}#site-links{display:flex!important}}</style></head><body><main><h1>Unfinished prototype</h1><p>Coming soon.</p></main><script></script></body></html>"
