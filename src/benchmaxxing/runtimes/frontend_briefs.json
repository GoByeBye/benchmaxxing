x-start;padding:20px}td,th{font-size:13px}.card,form,section{padding:16px}}@media(min-width:640px){.nav-toggle{display:none}#site-links{display:flex!important}}</style></head><body><main><header><strong>ATLAS</strong><button class=\"nav-toggle\" aria-expanded=\"false\" aria-controls=\"site-links\">Menu</button><nav id=\"site-links\" aria-label=\"Primary navigation\" hidden><a href=\"#overview\">Overview</a><a href=\"#features\">Features</a><a href=\"#pricing\">Pricing</a></nav></header><section><h1 id=\"view\">Overview</h1><p>A considered workspace for focused teams.</p></section></main><script>const menu=document.querySelector('.nav-toggle'),nav=document.querySelector('#site-links');function close(){nav.hidden=true;menu.setAttribute('aria-expanded','false');menu.focus()}menu.onclick=()=>{const expanded=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!expanded));nav.hidden=expanded;};document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});nav.querySelectorAll('a').forEach(a=>a.onclick=e=>{e.preventDefault();document.querySelector('#view').textContent=a.textContent;if(innerWidth<640)close();});</script></body></html>",
