flex-start;padding:20px}td,th{font-size:13px}.card,form,section{padding:16px}}@media(min-width:640px){.nav-toggle{display:none}#site-links{display:flex!important}}</style></head><body><main><small>ATLAS / CUSTOMER CARE</small><h1>How can we help?</h1><p>Send a request to our local support desk.</p><form novalidate><label for=\"name\">Full name</label><input id=\"name\" autocomplete=\"name\" required minlength=\"2\"><label for=\"email\">Email</label><input id=\"email\" type=\"email\" autocomplete=\"email\" required aria-describedby=\"email-help\"><small id=\"email-help\">We will use this address to reply.</small><label for=\"reason\">Contact reason</label><select id=\"reason\"><option>Support</option><option>Invoice</option></select><p role=\"alert\" class=\"error\" id=\"error\"></p><button type=\"submit\">Send request</button><p role=\"status\" id=\"success\"></p></form></main><script>document.querySelector('form').addEventListener('submit',e=>{e.preventDefault();const name=document.querySelector('#name'),email=document.querySelector('#email'),error=document.querySelector('#error'),success=document.querySelector('#success');success.textContent='';error.textContent='';if(name.value.trim().length<2||!email.validity.valid){error.textContent='Enter your full name and a valid email address.';email.setAttribute('aria-invalid',String(!email.validity.valid));return;}email.removeAttribute('aria-invalid');success.textContent='Request received for '+name.value.trim();});</script></body></html>",
