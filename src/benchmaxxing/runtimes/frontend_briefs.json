tems:flex-start;padding:20px}td,th{font-size:13px}.card,form,section{padding:16px}}@media(min-width:640px){.nav-toggle{display:none}#site-links{display:flex!important}}</style></head><body><main><small>ATLAS / PREFERENCES</small><h1>Make it yours</h1><section><h2>Appearance</h2><p>Choose a palette that fits your environment.</p><button id=\"theme\">Switch to dark mode</button><p role=\"status\" id=\"mode\">Light mode</p></section></main><script>let theme=localStorage.getItem('atlas-theme')||'light';function apply(){document.body.dataset.theme=theme;document.querySelector('#theme').textContent='Switch to '+(theme==='light'?'dark':'light')+' mode';document.querySelector('#mode').textContent=theme==='light'?'Light mode':'Dark mode';}document.querySelector('#theme').onclick=()=>{theme=theme==='light'?'dark':'light';localStorage.setItem('atlas-theme',theme);apply();};apply();</script></body></html>",
