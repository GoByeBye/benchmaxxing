    {
      "id": "orders-dashboard",
      "title": "Design an order operations dashboard",
      "requirements": "Build an orders dashboard with a semantic table and five orders: Ada/New/120, Bo/Paid/80, Cleo/Paid/45, Dion/New/60, Eli/Paid/100. Provide labelled Search orders input, Status filter select (All, Paid, New), and a live output with visible order count and sum (e.g. 5 orders \u00b7 $405). Search is case-insensitive customer substring; combine filters. Keep all controls and table usable at 390px and 1280px.",
      "good_solution": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Design an order operations dashboard</title><style>*{box-sizing:border-box}body{margin:0;background:#f0f4fa;color:#14213d;font:16px/1.5 system-ui,sans-serif}main{max-width:1050px;margin:auto;padding:clamp(20px,5vw,64px)}h1{font-size:clamp(28px,5vw,44px);line-height:1.1}h2{font-size:22px}button,input,select,textarea{font:inherit;max-width:100%;padding:10px 14px;border:1px solid #79879b;border-radius:8px}button{background:#173d81;color:white;cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #d65e00;outline-offset:3px}label{display:block;font-weight:650;margin-top:16px}input,textarea,select{background:white;color:#14213d}header,.toolbar{display:flex;gap:16px;flex-wrap:wrap;align-items:center;justify-content:space-between}.card,form,section{background:white;border:1px solid #cbd5e1;border-radius:14px;padding:24px;margin:20px 0;box-shadow:0 8px 30px #14213d08}table{border-collapse:collapse;width:100%;font-size:15px}td,th{text-align:left;padding:10px 4px;border-bottom:1px solid #dbe3ee}output,[role=status]{display:block;margin-top:18px;color:#064d37;font-weight:650}small{color:#4c5c74}[hidden]{display:none!important}a{color:#174e9b}nav{display:flex;gap:24px;align-items:center}dialog{max-width:min(90vw,440px);border:0;border-radius:16px;padding:28px;box-shadow:0 20px 100px #0005}dialog::backdrop{background:#14213d88}.actions{display:flex;gap:12px;justify-content:flex-end;margin-top:22px}[role=tablist]{display:flex;gap:8px;flex-wrap:wrap}[role=tab][aria-selected=true]{background:#0c563e}.error{color:#aa1818}body[data-theme=dark]{background:#111b2c;color:#eef5ff}body[data-theme=dark] section{background:#203049;color:#eef5ff;border-color:#51647f}@media(max-width:639px){.nav-toggle{display:block}#site-links{width:100%;flex-direction:column;align-items:flex-start;padding:20px}td,th{font-size:13px}.card,form,section{padding:16px}}@media(min-width:640px){.nav-toggle{display:none}#site-links{display:flex!important}}</style></head><body><main><header><div><small>ATLAS / OPERATIONS</small><h1>Orders dashboard</h1></div><strong>Today's overview</strong></header><section><div class=\"toolbar\"><div><label for=\"search\">Search orders</label><input id=\"search\" type=\"search\"></div><div><label for=\"status\">Status filter</label><select id=\"status\"><option>All</option><option>Paid</option><option>New</option></select></div></div><output id=\"summary\" aria-live=\"polite\"></output><table><thead><tr><th>Customer</th><th>Status</th><th>Amount</th></tr></thead><tbody id=\"orders\"></tbody></table></section></main><script>const rows=[['Ada','New',120],['Bo','Paid',80],['Cleo','Paid',45],['Dion','New',60],['Eli','Paid',100]];function render(){const q=document.querySelector('#search').value.toLowerCase(),s=document.querySelector('#status').value;const r=rows.filter(x=>x[0].toLowerCase().includes(q)&&(s==='All'||x[1]===s));document.querySelector('#orders').replaceChildren(...r.map(x=>{const tr=document.createElement('tr');x.forEach(v=>{const td=document.createElement('td');td.textContent=v;tr.append(td)});return tr}));document.querySelector('#summary').textContent=`${r.length} orders \u00b7 $${r.reduce((n,x)=>n+x[2],0)}`;}document.querySelector('#search').addEventListener('input',render);document.querySelector('#status').addEventListener('change',render);render();</script></body></html>",
