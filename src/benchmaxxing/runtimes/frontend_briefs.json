    {
      "id": "keyboard-tabs",
      "title": "Design keyboard-accessible workspace tabs",
      "requirements": "Build Analyst, Operator, Settings tabs with tablist/tab/tabpanel semantics. Analyst is selected initially. Associate each tab to its visible panel with aria-controls/labelledby. Clicking or ArrowRight/ArrowLeft cycles selection and focus; Home selects Analyst, End selects Settings. Exactly one tab has tabindex=0 and aria-selected=true; inactive panels are hidden. Each panel must have unique useful content.",
      "good_solution": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Design keyboard-accessible workspace tabs</title><style>*{box-sizing:border-box}body{margin:0;background:#f0f4fa;color:#14213d;font:16px/1.5 system-ui,sans-serif}main{max-width:1050px;margin:auto;padding:clamp(20px,5vw,64px)}h1{font-size:clamp(28px,5vw,44px);line-height:1.1}h2{font-size:22px}button,input,select,textarea{font:inherit;max-width:100%;padding:10px 14px;border:1px solid #79879b;border-radius:8px}button{background:#173d81;color:white;cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #d65e00;outline-offset:3px}label{display:block;font-weight:650;margin-top:16px}input,textarea,select{background:white;color:#14213d}header,.toolbar{display:flex;gap:16px;flex-wrap:wrap;align-items:center;justify-content:space-between}.card,form,section{background:white;border:1px solid #cbd5e1;border-radius:14px;padding:24px;margin:20px 0;box-shadow:0 8px 30px #14213d08}table{border-collapse:collapse;width:100%;font-size:15px}td,th{text-align:left;padding:10px 4px;border-bottom:1px solid #dbe3ee}output,[role=status]{display:block;margin-top:18px;color:#064d37;font-weight:650}small{color:#4c5c74}[hidden]{display:none!important}a{color:#174e9b}nav{display:flex;gap:24px;align-items:center}dialog{max-width:min(90vw,440px);border:0;border-radius:16px;padding:28px;box-shadow:0 20px 100px #0005}dialog::backdrop{background:#14213d88}.actions{display:flex;gap:12px;justify-content:flex-end;margin-top:22px}[role=tablist]{display:flex;gap:8px;flex-wrap:wrap}[role=tab][aria-selected=true]{background:#0c563e}.error{color:#aa1818}body[data-theme=dark]{background:#111b2c;color:#eef5ff}body[data-theme=dark] section{background:#203049;color:#eef5ff;border-color:#51647f}@media(max-width:639px){.nav-toggle{display:block}#site-links{width:100%;flex-direction:column;align-items:flex-start;padding:20px}td,th{font-size:13px}.card,form,section{padding:16px}}@media(min-width:640px){.nav-toggle{display:none}#site-links{display:flex!important}}</style></head><body><main><small>ATLAS / WORKSPACE</small><h1>Your workspace</h1><div role=\"tablist\" aria-label=\"Workspace views\"><button role=\"tab\" id=\"t0\" aria-controls=\"p0\" aria-selected=\"true\" tabindex=\"0\">Analyst</button><button role=\"tab\" id=\"t1\" aria-controls=\"p1\" aria-selected=\"false\" tabindex=\"-1\">Operator</button><button role=\"tab\" id=\"t2\" aria-controls=\"p2\" aria-selected=\"false\" tabindex=\"-1\">Settings</button></div><section role=\"tabpanel\" id=\"p0\" aria-labelledby=\"t0\" ><h2>Analyst</h2><p>Explore daily activity and compare trends.</p></section><section role=\"tabpanel\" id=\"p1\" aria-labelledby=\"t1\" hidden><h2>Operator</h2><p>Review the queue and handle pending work.</p></section><section role=\"tabpanel\" id=\"p2\" aria-labelledby=\"t2\" hidden><h2>Settings</h2><p>Manage workspace preferences and accessibility.</p></section></main><script>const tabs=[...document.querySelectorAll('[role=tab]')];function select(i){tabs.forEach((t,j)=>{t.setAttribute('aria-selected',String(i===j));t.tabIndex=i===j?0:-1;document.querySelector('#p'+j).hidden=i!==j});tabs[i].focus();}tabs.forEach((t,i)=>{t.onclick=()=>select(i);t.onkeydown=e=>{let n=i;if(e.key==='ArrowRight')n=(i+1)%tabs.length;else if(e.key==='ArrowLeft')n=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')n=0;else if(e.key==='End')n=tabs.length-1;else return;e.preventDefault();select(n);};});</script></body></html>",
      "bad_solution": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Design keyboard-accessible workspace tabs</title><style>*{box-sizing:border-box}body{margin:0;background:#f0f4fa;color:#14213d;font:16px/1.5 system-ui,sans-serif}main{max-width:1050px;margin:auto;padding:clamp(20px,5vw,64px)}h1{font-size:clamp(28px,5vw,44px);line-height:1.1}h2{font-size:22px}button,input,select,textarea{font:inherit;max-width:100%;padding:10px 14px;border:1px solid #79879b;border-radius:8px}button{background:#173d81;color:white;cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #d65e00;outline-offset:3px}label{display:block;font-weight:650;margin-top:16px}input,textarea,select{background:white;color:#14213d}header,.toolbar{display:flex;gap:16px;flex-wrap:wrap;align-items:center;justify-content:space-between}.card,form,section{background:white;border:1px solid #cbd5e1;border-radius:14px;padding:24px;margin:20px 0;box-shadow:0 8px 30px #14213d08}table{border-collapse:collapse;width:100%;font-size:15px}td,th{text-align:left;padding:10px 4px;border-bottom:1px solid #dbe3ee}output,[role=status]{display:block;margin-top:18px;color:#064d37;font-weight:650}small{color:#4c5c74}[hidden]{display:none!important}a{color:#174e9b}nav{display:flex;gap:24px;align-items:center}dialog{max-width:min(90vw,440px);border:0;border-radius:16px;padding:28px;box-shadow:0 20px 100px #0005}dialog::backdrop{background:#14213d88}.actions{display:flex;gap:12px;justify-content:flex-end;margin-top:22px}[role=tablist]{display:flex;gap:8px;flex-wrap:wrap}[role=tab][aria-selected=true]{background:#0c563e}.error{color:#aa1818}body[data-theme=dark]{background:#111b2c;color:#eef5ff}body[data-theme=dark] section{background:#203049;color:#eef5ff;border-color:#51647f}@media(max-width:639px){.nav-toggle{display:block}#site-links{width:100%;flex-direction:column;align-items