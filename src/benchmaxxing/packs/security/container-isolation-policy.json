{
  "schema_version": 1,
  "id": "security.container-isolation-policy",
  "version": "1.0.0",
  "title": "Audit a synthetic container isolation specification",
  "category": "security",
  "difficulty": "medium",
  "tags": [
    "defensive",
    "sandbox-isolation",
    "static-policy"
  ],
  "kind": "python",
  "entrypoint": "solve",
  "prompt": "Implement solve(payload) to statically audit a synthetic container specification against this deliberately limited lab policy. Do not run containers, inspect the host, or contact a network. Every input contains network and user strings; read_only, privileged and no_new_privileges booleans; cap_drop and mounts string lists; and memory_mb and pids_limit integers (not booleans). Return exactly {\"issues\": [codes]} with unique codes sorted lexicographically. Each failed field contributes its field name as a code. Require network exactly \"none\"; user matching ASCII digits:digits with numeric UID >0 (GID may be zero, leading zeros permitted); read_only true; privileged false; cap_drop containing the exact string \"ALL\"; no_new_privileges true; mounts empty; memory_mb in inclusive range 1..512; pids_limit in inclusive range 1..128. Ignore unknown fields and additional cap_drop entries. Do not mutate input. This static exercise scores only the specified fields and does not certify actual runtime isolation.",
  "files": {
    "solution.py": "def solve(payload):\n    raise NotImplementedError(\"Implement solve(payload)\")\n",
    "public_tests.py": "import copy\nfrom solution import solve\n\nCASES = [{'name': 'isolated', 'input': {'network': 'none', 'user': '1000:1000', 'read_only': True, 'privileged': False, 'cap_drop': ['ALL'], 'no_new_privileges': True, 'mounts': [], 'memory_mb': 256, 'pids_limit': 64}, 'expected': {'issues': []}}, {'name': 'external_network', 'input': {'network': 'bridge', 'user': '1000:1000', 'read_only': True, 'privileged': False, 'cap_drop': ['ALL'], 'no_new_privileges': True, 'mounts': [], 'memory_mb': 256, 'pids_limit': 64}, 'expected': {'issues': ['network']}}, {'name': 'root_user', 'input': {'network': 'none', 'user': '0:1000', 'read_only': True, 'privileged': False, 'cap_drop': ['ALL'], 'no_new_privileges': True, 'mounts': [], 'memory_mb': 256, 'pids_limit': 64}, 'expected': {'issues': ['user']}}]\nfor case in CASES:\n    value = copy.deepcopy(case[\"input\"])\n    assert solve(value) == case[\"expected\"], case[\"name\"]\n    assert value == case[\"input\"], \"Do not mutate input\"\nprint(\"Public examples passed\")\n"
  },
  "good_solution": "def solve(payload):\n    import re\n    issues = []\n    if payload[\"network\"] != \"none\":\n        issues.append(\"network\")\n    match = re.fullmatch(r\"([0-9]+):([0-9]+)\", payload[\"user\"])\n    if match is None or int(match.group(1)) == 0:\n        issues.append(\"user\")\n    if not payload[\"read_only\"]:\n        issues.append(\"read_only\")\n    if payload[\"privileged\"]:\n        issues.append(\"privileged\")\n    if \"ALL\" not in payload[\"cap_drop\"]:\n        issues.append(\"cap_drop\")\n    if not payload[\"no_new_privileges\"]:\n        issues.append(\"no_new_privileges\")\n    if payload[\"mounts\"]:\n        issues.append(\"mounts\")\n    for key, maximum in ((\"memory_mb\", 512), (\"pids_limit\", 128)):\n        if not 1 <= payload[key] <= maximum:\n            issues.append(key)\n    return {\"issues\": sorted(issues)}\n",
  "bad_solution": "def solve(payload):\n    return {\"issues\": []}\n",
